{
  "name": "gitdown",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:client": "esbuild src/client/main.ts --bundle --minify --format=esm --target=es2022 --outfile=public/js/app.js && node scripts/check-assets.mjs",
    "dev": "wrangler dev --test-scheduled",
    "db:migrate": "wrangler d1 migrations apply gitdown --local",
    "db:migrate:remote": "wrangler d1 migrations apply gitdown --remote",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "types": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit && tsc --noEmit -p tsconfig.client.json"
  },
  "dependencies": {
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.19.1",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.45.0"
  }
}
