{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gitdown",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",

  // The front end is a build artifact under `dist/`, which is gitignored — so
  // it exists only because something built it. `wrangler deploy` uploads the
  // assets directory as it finds it, so a deploy that skipped the build would
  // ship whatever happened to be lying there, or nothing at all, and no step
  // would complain. Building here rather than in the npm script means every
  // path into wrangler rebuilds it first: `deploy`, `dev`, and the bare
  // `wrangler versions upload` that Cloudflare's build pipeline runs.
  //
  // Vite emits the shell, the bundle and the stylesheet together under hashed
  // names, so the three can no longer be from different generations either.
  //
  // `vite dev` prints a warning that it is ignoring this, which is correct and
  // wanted: in dev the Vite plugin serves the front end itself and there is
  // nothing to prebuild. The key is only here for the paths that go through the
  // wrangler CLI. Deleting it to silence the warning breaks the deploy.
  "build": {
    "command": "npm run build"
  },

  // A request matching a static file is served by the edge without invoking the
  // Worker, and is never billed. Anything else falls through to `fetch`, which
  // is how /issues/:n gets a real URL rather than a query parameter.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    // Without this the asset router answers /issues/6 itself before the Worker
    // sees it. These three prefixes always invoke the Worker; everything else
    // (CSS, JS, images) is still served free and uncounted.
    //
    // The Worker returns the same SPA shell for /issues/* and /503, and for
    // anything that matched nothing — what differs is the status code, which is
    // the whole reason those two do not use `not_found_handling`.
    "run_worker_first": ["/issues/*", "/api/*", "/503"]
  },

  // Statuspage incidents move on the order of minutes; one minute is the
  // shortest interval Cron Triggers support and is well inside that.
  "triggers": {
    "crons": ["* * * * *"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gitdown",
      "database_id": "c8e2c8af-2069-4314-88c8-89029ed60924",
      "migrations_dir": "migrations"
    }
  ],

  // Keep the workers.dev URL alive alongside the custom domain. Declaring
  // `routes` without this silently turns it off.
  "workers_dev": true,

  // Declared here rather than left as dashboard-only state, so the domain is
  // reproducible from the repo and a deploy cannot quietly drop it. Cloudflare
  // manages the DNS record and TLS certificate for a custom domain itself.
  "routes": [{ "pattern": "gitdown.chat", "custom_domain": true }],

  "vars": {
    // How much history the one-time backfill seeds. Raise it locally when
    // GitHub has been behaving and a week of history is empty.
    "BACKFILL_DAYS": "7"
  },

  "observability": {
    "enabled": true
  }
}
