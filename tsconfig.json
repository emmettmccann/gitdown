{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "es2022",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true
  },
  // worker-configuration.d.ts is generated by `wrangler types` (see the
  // typecheck script) and is intentionally not committed — it is derived from
  // wrangler.jsonc and the pinned workerd version.
  "include": ["src/**/*.ts", "test/**/*.ts", "*.ts", "worker-configuration.d.ts"],
  // The browser bundle needs the DOM lib, which would mask Workers types here.
  // It is typechecked separately via tsconfig.client.json.
  "exclude": ["src/client"]
}
